    const pt = pageThemeForFile(ctx.page)
    if (pt) return code.replace('<html ', `<html data-tpl="${pt.id}" `).replace(/(<html[^>]*?class=")/, pt.defaultDark ? '$1tpl-dark ' : '$1')
