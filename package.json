    "build:scopecraft-bs6": "node scripts/build-scopecraft-bs6-css.mjs",
    "preview": "vitepress preview",
    "test:newrelic": "node --test tests/newrelic-browser.cjs",
    "test:pulsefit-bs6": "node tests/pulsefit-bs6.cjs",
    "test:felix-bootstrap": "node tests/felix-bootstrap.cjs",
    "test:decision-tree": "node tests/decision-tree.cjs",
    "build:batch2-bs6": "node scripts/build-batch2-bs6.mjs",
    "build:bastion-bs6": "node scripts/build-bastion-bs6.mjs",
    "test:bastion": "node tests/bastion.cjs",
    "test:batch2-bs6": "node tests/batch2-bs6.cjs",
    "test:relay": "node tests/relay-dashboard.cjs",
    "test:home-care": "node tests/home-care.cjs"
  },
  "devDependencies": {
    "@fortawesome/fontawesome-free": "^7.3.1",
    "mermaid": "^12.2.0",
    "playwright": "^1.64.1",
    "postcss": "^8.5.32",
    "postcss-prefix-selector": "^2.2.1",
    "vitepress": "^1.6.3"
  },
  "allowScripts": {
    "esbuild@0.21.5": true
  },
