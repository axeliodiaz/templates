/** Local, pinned MIT Bootstrap. Native @scope contains reboot, tokens and components. */
import fs from 'node:fs'
import postcss from 'postcss'
const source = 'node_modules/bootstrap/dist/css/bootstrap.css'
const css = postcss.parse(fs.readFileSync(source, 'utf8'))
css.walkAtRules('charset', rule => rule.remove())
css.walkRules(rule => {
  if (rule.parent?.type === 'atrule' && /keyframes$/.test(rule.parent.name)) return
  rule.selectors = rule.selectors.map(selector => selector.replace(/:root|:host|\bhtml\b|\bbody\b/g, ':scope'))
})
const scope = postcss.atRule({name:'scope',params:'(.b2-bs6)'})
scope.append(css.nodes)
fs.writeFileSync('.vitepress/theme/batch2-bs6.bootstrap.css', '/* Generated by scripts/build-batch2-bs6.mjs. Bootstrap MIT, v6.0.0-alpha.1. */\n'+scope.toString()+'\n')
